{
  "schema_version": 1,
  "adapter": "gradle",
  "workspace": "my-org/my-project",
  "workspace_source": "explicit",
  "tag": "gradle",
  "env_vars": {},
  "setup": {
    "schema_version": 2,
    "files": [
      {
        "path": "/tmp/boringcache-fixture/gradle.properties",
        "mode": "replace-block",
        "content": "org.gradle.caching=true\n"
      }
